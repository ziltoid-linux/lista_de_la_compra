FROM ghcr.io/cirruslabs/flutter:stable

# The project requires Flutter 3.44.8. CirrusLabs does not publish every
# Flutter patch release, so install the exact official SDK archive.
USER root
RUN rm -rf /sdks/flutter \
    && curl -fsSL https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.44.8-stable.tar.xz \
       | tar -xJ -C /sdks \
    && git config --global --add safe.directory /sdks/flutter \
    && /sdks/flutter/bin/flutter precache --android \
    && /sdks/flutter/bin/flutter --version

ENV FLUTTER_HOME=/sdks/flutter
ENV FLUTTER_ROOT=/sdks/flutter
ENV FLUTTER_VERSION=3.44.8
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/android-sdk-linux/cmdline-tools/latest/bin:/opt/android-sdk-linux/platform-tools:/opt/android-sdk-linux/emulator:/sdks/flutter/bin:/sdks/flutter/bin/cache/dart-sdk/bin

RUN apt-get update && apt-get install -y cmake ninja-build clang pkg-config libgtk-3-dev liblzma-dev lld

WORKDIR /app

ENV PUB_CACHE=/cache/pub-cache
ENV GRADLE_USER_HOME=/cache/gradle-cache
RUN mkdir -p $PUB_CACHE $GRADLE_USER_HOME

ARG USER_ID
ARG GROUP_ID
RUN echo "Using UID: $USER_ID and GID: $GROUP_ID"
RUN chown -R $USER_ID:$GROUP_ID $PUB_CACHE $GRADLE_USER_HOME
RUN chown -R $USER_ID:$GROUP_ID /sdks/flutter

USER $USER_ID:$GROUP_ID
